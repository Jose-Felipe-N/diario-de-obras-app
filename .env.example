# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e nunca deve ser commitado.

# Chave da API do Gemini (crie em https://aistudio.google.com/apikey)
GEMINI_API_KEY=sua_chave_aqui

# As variáveis abaixo são opcionais. Sem elas, valem os padrões indicados.
# Uma variável definida no terminal tem prioridade sobre este arquivo.

# Modelo usado pelo Analista IA.
# GEMINI_MODEL=gemini-2.5-flash

# Arquivo do banco SQLite (relativo à pasta do projeto ou caminho absoluto).
# DIARIO_DB_PATH=diario_obra.db

# Endereço da API chamado pelo frontend (ex.: http://127.0.0.1:8001 para uma
# segunda cópia do app rodando em outra porta).
# API_URL=http://127.0.0.1:8000
